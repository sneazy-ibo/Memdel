{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "isolatedModules": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "skipLibCheck": true,
        "noEmitOnError": false
    },
    "include": ["src/**/*.ts"]
}

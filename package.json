{
    "name": "memdel",
    "version": "0.2.0",
    "description": "Record and clip HTML canvas + Web Audio output to MP4",
    "license": "GPL-3.0-or-later",
    "author": "sneazy-ibo",
    "homepage": "https://github.com/sneazy-ibo/Memdel#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/sneazy-ibo/Memdel"
    },
    "bugs": "https://github.com/sneazy-ibo/Memdel/issues",
    "keywords": [
        "recording",
        "canvas",
        "webaudio",
        "webcodecs",
        "game-recording",
        "clipping",
        "medal.tv",
        "mp4",
        "webm",
        "browser"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "jsdelivr": "dist/index.iife.min.js",
    "unpkg": "dist/index.iife.min.js",
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@11.22.0",
    "peerDependencies": {
        "mediabunny": ">=1.0.0"
    },
    "devDependencies": {
        "@types/wicg-file-system-access": "^2023.10.7",
        "esbuild": "^0.28.2",
        "mediabunny": "^1.56.0",
        "prettier": "3.9.6",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "node build.js && npm run build:types",
        "build:test": "node test/build-script.mjs",
        "build:types": "tsc --emitDeclarationOnly --outDir dist",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run build"
    }
}
